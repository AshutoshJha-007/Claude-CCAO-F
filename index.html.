<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Claude Associate">
<title>Claude Associate Prep</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;700;800&display=swap">
<style>
/* VOICE professional course site, calm and clear, easy English, ready to record on video
   IDEA a metro map: the course is a train line, modules are coloured lines, lessons are stations
   PICTURE the course map on the home page; inside lessons, the question cards that pop open are the star
   COLOUR white ground, near-black ink, module colours red / blue / amber / green, blue for actions
   TYPE Figtree 800 titles, Figtree 400/500 text
   LAYOUT top bar + left lesson rail on desktop; on phone the rail becomes a scrolling row; presenter mode hides the rail and enlarges text */
:root{color-scheme:light dark;--bg:light-dark(#ffffff,#0e1116);--ink:light-dark(#101318,#eef1f5);--soft:light-dark(#566070,#a6aebb);--panel:light-dark(#f4f6f9,#161b23);--edge:light-dark(#dfe4ea,#29303b);--blue:light-dark(#0a5cff,#5b93ff);--red:#e6261f;--bl:#0a5cff;--amber:#e8a200;--green:#00a05a;--ok:light-dark(#00874c,#3fd18c);--okbg:light-dark(#e5f7ee,#0f2a1e);--bad:light-dark(#c81e1e,#ff7b7b);--badbg:light-dark(#fdeaea,#2c1414)}
:root[data-theme=light]{color-scheme:light}:root[data-theme=dark]{color-scheme:dark}
*{box-sizing:border-box;min-width:0}
html{scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--ink);font:calc(17px * var(--fs,1))/1.6 Figtree,system-ui,sans-serif;overflow-x:clip}
h1,h2,h3{font-weight:800;line-height:1.1;letter-spacing:-.02em;text-wrap:balance;margin:0 0 .45em}
h1{font-size:clamp(34px,4.6vw,52px)}
h2{font-size:clamp(26px,3vw,34px);margin-top:1.4em}
h3{font-size:20px}
p{margin:0 0 .85em;max-width:72ch}
a{color:var(--blue)}
ul{padding-left:1.2em;margin:.3em 0 .9em}
li{margin:.3em 0}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
/* top bar */
.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px max(3vw,16px);background:var(--bg);border-bottom:1px solid var(--edge)}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;text-decoration:none;color:var(--ink);margin-right:auto}
.logo{width:34px;height:34px;flex:none}
.btn{min-height:44px;padding:9px 13px;font-size:15px;border-radius:10px;border:1px solid var(--edge);background:var(--panel);font-weight:700}
.btn.main{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.btn[aria-pressed=true]{background:var(--blue);color:#fff;border-color:var(--blue)}
.bar{height:6px;background:var(--panel);flex-basis:100%;border-radius:3px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--green);width:0;transition:width .5s}
/* shell */
.shell{display:grid;grid-template-columns:290px minmax(0,1fr);max-width:1320px;margin:0 auto}
.rail{border-right:1px solid var(--edge);padding:18px 14px;position:sticky;top:var(--hh,140px);align-self:start;max-height:calc(100vh - var(--hh,140px));overflow:auto}
.rail h4{margin:16px 10px 6px;font-size:14px;color:var(--soft);font-weight:700}
.rail a{display:flex;gap:10px;align-items:center;padding:9px 10px;border-radius:10px;text-decoration:none;color:var(--ink);font-weight:500;min-height:44px;line-height:1.25}
.rail a:hover{background:var(--panel)}
.rail a.on{background:var(--panel);font-weight:800}
.num{flex:none;width:28px;height:28px;border-radius:50%;border:4px solid var(--c,var(--soft));display:grid;place-items:center;font-size:12px;font-weight:800;background:var(--bg)}
.rail a.done .num{background:var(--c);color:#fff}
main{padding:clamp(22px,3.5vw,48px) max(4vw,16px) 80px}
.page{max-width:900px}
@media(max-width:900px){.shell{grid-template-columns:1fr}.rail{position:static;max-height:none;border-right:0;border-bottom:1px solid var(--edge);display:flex;overflow-x:auto;gap:4px;padding:8px 12px}.rail h4{display:none}.rail a{flex:none}}
/* presenter mode */
body.present{font-size:calc(21px * var(--fs,1))}
body.present .shell{grid-template-columns:1fr}
body.present .rail{display:none}
body.present .page{max-width:1100px;margin:0 auto}
body.present h1{font-size:clamp(40px,5.4vw,64px)}
body.present .qhead{font-size:24px}
body.present .hint{display:block}
.hint{display:none;color:var(--soft);font-size:15px;margin-bottom:18px}
/* home map */
.map{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin:26px 0 10px}
@media(max-width:820px){.map{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.map{grid-template-columns:1fr}}
.line{position:relative;padding:16px 16px 10px 54px;background:var(--panel);border-radius:16px;border:1px solid var(--edge)}
.line::before{content:"";position:absolute;left:24px;top:58px;bottom:28px;width:10px;border-radius:5px;background:var(--c)}
.line h3{margin:0 0 12px -38px;display:flex;gap:10px;align-items:center;font-size:18px}
.line h3 .num{width:32px;height:32px;background:var(--c);color:#fff;border-color:var(--c)}
.stop{display:block;position:relative;text-decoration:none;color:var(--ink);padding:8px 0 14px;font-weight:700;line-height:1.25}
.stop::before{content:"";position:absolute;left:-38px;top:8px;width:20px;height:20px;border-radius:50%;background:var(--bg);border:5px solid var(--c)}
.stop.done::before{background:var(--c)}
.stop small{display:block;font-weight:400;color:var(--soft);font-size:14px;margin-top:2px}
.stop:hover{color:var(--blue)}
/* content blocks */
.tag{display:inline-flex;align-items:center;gap:8px;font-weight:700;color:var(--soft);margin-bottom:10px}
.tag .dot{width:12px;height:12px;border-radius:50%;background:var(--c)}
.goal{font-size:19px;color:var(--soft);border-left:6px solid var(--c);padding-left:16px;margin:6px 0 24px}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:12px 0 18px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:12px 0 18px}
@media(max-width:720px){.grid2,.grid3{grid-template-columns:1fr}}
.card{background:var(--panel);border:1px solid var(--edge);border-radius:14px;padding:16px 18px}
.card h3{margin-bottom:6px}
.card p:last-child,.card ul:last-child{margin-bottom:0}
.say{background:color-mix(in srgb,var(--amber) 18%,var(--bg));border-radius:14px;padding:14px 18px;margin:18px 0;font-weight:500}
.say b{display:block;margin-bottom:2px}
.act{border:2px dashed var(--edge);border-radius:14px;padding:14px 18px;margin:18px 0}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;margin:8px 0 18px}
th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--edge);vertical-align:top}
th{font-size:15px;color:var(--soft)}
td:first-child{font-weight:800}
@media(max-width:600px){table{font-size:15px}.stack thead{display:none}.stack tr{display:grid;padding-block:10px;border-bottom:1px solid var(--edge)}.stack td{display:flow-root;border:0;padding:3px 0;padding-inline-start:7.5em}.stack td::before{content:attr(data-l);float:inline-start;width:7em;margin-inline-start:-7.5em;color:var(--soft);font-weight:700}}
.cmp{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
@media(max-width:720px){.cmp{grid-template-columns:1fr}}
.bad{border-top:8px solid var(--bad)}.good{border-top:8px solid var(--ok)}
/* Q&A */
.qtools{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:10px 0 16px}
.qa{border:1px solid var(--edge);border-radius:16px;margin:0 0 14px;background:var(--bg);transition:border-color .3s,box-shadow .3s}
.qa.open{border-color:var(--ok);box-shadow:0 0 0 3px color-mix(in srgb,var(--ok) 18%,transparent)}
.qhead{display:flex;gap:14px;align-items:flex-start;width:100%;text-align:left;background:none;border:0;padding:16px 18px;font-weight:700;font-size:19px;line-height:1.35;min-height:56px}
.qn{flex:none;background:var(--ink);color:var(--bg);border-radius:8px;padding:2px 9px;font-size:15px;margin-top:2px}
.qtext{flex:1}
.qtext small{display:block;font-weight:500;color:var(--blue);font-size:14px;margin-top:4px}
.chev{flex:none;width:30px;height:30px;border-radius:50%;background:var(--panel);display:grid;place-items:center;transition:transform .4s cubic-bezier(.34,1.56,.64,1)}
.chev::before{content:"";width:9px;height:9px;border-right:3px solid currentColor;border-bottom:3px solid currentColor;transform:translateY(-2px) rotate(45deg)}
.qa.open .chev{transform:rotate(180deg);background:var(--okbg);color:var(--ok)}
.opts{display:grid;gap:8px;padding:0 18px 14px}
.opt{display:flex;gap:10px;align-items:center;text-align:left;padding:11px 14px;border-radius:10px;border:1px solid var(--edge);background:var(--panel);min-height:44px;transition:background .3s,border-color .3s,transform .2s}
@media(hover:hover){.opt:hover{transform:translateX(3px)}}
.opt .k{flex:none;width:26px;height:26px;border-radius:50%;border:2px solid var(--edge);display:grid;place-items:center;font-weight:800;font-size:13px}
.qa.open .opt{cursor:default;transform:none}
.qa.open .opt.right{background:var(--okbg);border-color:var(--ok);animation:glow .9s ease}
.qa.open .opt.right .k{background:var(--ok);border-color:var(--ok);color:#fff}
.opt.wrong{background:var(--badbg);border-color:var(--bad)}
.opt.wrong .k{background:var(--bad);border-color:var(--bad);color:#fff}
.qbody{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s cubic-bezier(.2,.8,.2,1)}
.qa.open .qbody{grid-template-rows:1fr}
.qinner{overflow:hidden}
.answer{margin:0 18px 18px;padding:16px 18px;border-radius:12px;background:var(--okbg);border-left:6px solid var(--ok);opacity:0;transform:translateY(-14px) scale(.96);transform-origin:top left;transition:opacity .35s .12s,transform .55s .12s cubic-bezier(.34,1.56,.64,1)}
.qa.open .answer{opacity:1;transform:none}
.answer .lbl{display:inline-block;font-weight:800;color:var(--ok);margin-bottom:4px}
.answer .you{font-weight:700;margin-bottom:6px}
.answer p:last-child,.answer ul:last-child{margin-bottom:0}
@keyframes glow{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--ok) 55%,transparent)}100%{box-shadow:0 0 0 12px transparent}}
@media(prefers-reduced-motion:reduce){.qbody,.answer,.chev,.opt,.bar i{transition:none}.qa.open .opt.right{animation:none}}
.score{font-size:24px;font-weight:800}
.nav2{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:34px;padding-top:20px;border-top:1px solid var(--edge)}
.nav2 a{text-decoration:none;font-weight:800;padding:12px 18px;border-radius:12px;background:var(--panel);border:1px solid var(--edge);color:var(--ink);min-height:44px}
.nav2 a.next{background:var(--ink);color:var(--bg)}
.check{display:flex;gap:10px;align-items:center;font-weight:700;min-height:44px;cursor:pointer;margin-top:18px}
.check input{width:22px;height:22px;accent-color:var(--green)}
label.f{display:block;font-weight:700;margin:10px 0 4px}
input[type=text],select,textarea{width:100%;font:16px/1.4 Figtree,system-ui,sans-serif;padding:11px 12px;border:1px solid var(--edge);border-radius:10px;background:var(--bg);color:var(--ink)}
textarea{min-height:64px;resize:vertical}
pre{white-space:pre-wrap;background:var(--panel);border:1px solid var(--edge);border-radius:12px;padding:14px;font:15px/1.55 ui-monospace,Menlo,monospace;margin:0;min-height:200px}
.kbd{display:inline-block;border:1px solid var(--edge);border-bottom-width:3px;border-radius:6px;padding:0 7px;font-size:14px;font-weight:700;background:var(--panel)}
footer{color:var(--soft);font-size:15px;margin-top:40px}
.tabs{flex-basis:100%;display:flex;gap:6px;overflow-x:auto;padding:2px 0}
.tabs a{flex:none;text-decoration:none;color:var(--ink);font-weight:700;padding:9px 14px;border-radius:999px;border:1px solid var(--edge);min-height:44px;display:flex;align-items:center;gap:8px;background:var(--bg)}
.tabs a:hover{background:var(--panel)}
.tabs a.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.tabs a .wd{width:10px;height:10px;border-radius:50%;background:var(--c,var(--soft))}
.rail a.sub{padding:6px 10px 6px 48px;min-height:38px;font-size:15px;color:var(--soft)}
.rail a.sub.done{color:var(--ok)}
.rail a.sub.done::after{content:" ✓";font-weight:800}
.lesson{border-top:1px solid var(--edge);padding-top:34px;margin-top:40px}
.lesson h2.lt{font-size:clamp(28px,3.4vw,40px);margin-top:.2em}
.weekhead{background:var(--panel);border:1px solid var(--edge);border-left:10px solid var(--c);border-radius:14px;padding:16px 20px;margin:8px 0 6px}
.weekhead ul{margin:.3em 0 0}
.allweek{margin-top:60px;padding-top:10px;border-top:6px solid var(--c)}
/* MOBILE AND TABLET */
.tools{display:contents}
.menubtn,.bnav,.totop,.scrim{display:none}
.bnav button,.bnav a{font:inherit;color:var(--ink);background:none;border:0;border-radius:12px;min-height:52px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-size:12px;font-weight:700;text-decoration:none;padding:4px 2px;-webkit-tap-highlight-color:transparent}
.bnav .ic{font-size:20px;line-height:1}
.bnav button:active,.bnav a:active{background:var(--panel)}
.bnav [aria-disabled=true]{opacity:.35;pointer-events:none}
@media(max-width:900px){
 html{-webkit-text-size-adjust:100%}
 .top{padding:8px max(12px,env(safe-area-inset-left));gap:8px}
 .brand{font-size:16px;gap:8px}.logo{width:30px;height:30px}
 .menubtn{display:inline-flex;align-items:center;gap:6px}
 .tools{display:none;flex-basis:100%;flex-wrap:wrap;gap:8px}
 .top.toolsopen .tools{display:flex}
 .tools input{flex:1 1 100%;width:100%!important}
 .tools .btn{flex:1 1 calc(50% - 8px)}
 #b-present{display:none}
 .shell{display:block}
 .rail{display:block!important;position:fixed!important;top:0;left:0;bottom:0;width:min(86vw,340px);max-height:none!important;z-index:60;background:var(--bg);transform:translateX(-105%);transition:transform .3s ease;border-right:1px solid var(--edge)!important;border-bottom:0!important;padding:14px 12px calc(30px + env(safe-area-inset-bottom))!important;overflow-y:auto!important;overscroll-behavior:contain;box-shadow:0 0 40px rgba(0,0,0,.25)}
 body.drawer .rail{transform:none}
 .rail h4{display:block!important}
 .rail a{flex:initial!important}
 .scrim{display:block;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:55;opacity:0;pointer-events:none;transition:opacity .3s}
 body.drawer .scrim{opacity:1;pointer-events:auto}
 body.drawer{overflow:hidden}
 .drawhead{display:flex!important}
 .bnav{display:grid;position:fixed;left:0;right:0;bottom:0;z-index:30;grid-template-columns:repeat(5,1fr);gap:2px;background:var(--bg);border-top:1px solid var(--edge);padding:4px 6px calc(4px + env(safe-area-inset-bottom))}
 main{padding:18px 16px calc(100px + env(safe-area-inset-bottom))}
 .totop{position:fixed;right:14px;bottom:calc(76px + env(safe-area-inset-bottom));z-index:29;width:46px;height:46px;border-radius:50%;border:1px solid var(--edge);background:var(--bg);box-shadow:0 4px 14px rgba(0,0,0,.15);font-size:20px;font-weight:800;opacity:0;pointer-events:none;transition:opacity .3s;display:grid;place-items:center}
 .totop.show{opacity:1;pointer-events:auto}
 .nav2 a{flex:1 1 100%;text-align:center}
 .lesson{margin-top:28px;padding-top:24px}
}
@media(max-width:600px){
 .tabs{display:none}
 .btl{display:none}
 .top .btn.menubtn{min-height:42px;padding:8px 12px}
 h1{font-size:clamp(28px,8vw,36px)}
 h2{font-size:clamp(22px,6.4vw,26px)}
 .lesson h2.lt{font-size:clamp(26px,7.5vw,32px)}
 .goal{font-size:17px}
 .card{padding:14px}
 .qhead{font-size:17px;padding:14px;gap:10px}
 .opts{padding:0 12px 12px}
 .opt{padding:12px}
 .answer{margin:0 12px 14px;padding:14px}
 .spot{padding:0;place-items:stretch}
 .spotbox{border-radius:0;max-height:none;height:100%;padding:16px 16px calc(20px + env(safe-area-inset-bottom))}
 .cert{border-width:8px;outline-offset:-18px;padding:26px 14px}
 .tag{flex-wrap:wrap}
 .dstep .btn{width:100%}
 .weekhead{padding:14px}
 .swipehint{display:block!important}
}
.demo{border-left:8px solid var(--blue);margin:0 0 14px}
.demo h3{margin-bottom:8px}
.dstep{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 10px;align-items:start;margin:8px 0}
.dstep .dl{grid-column:1/-1;font-weight:800;font-size:14px;color:var(--blue)}
.dstep .pr{white-space:pre-wrap;background:var(--bg);border:1px solid var(--edge);border-radius:10px;padding:10px 12px;margin:0;font-size:16px}
.dstep .cmsg{grid-column:1/-1;color:var(--soft);font-size:14px}
.demo .ex{margin:6px 0 0;font-size:16px}
.demohead{display:flex;gap:12px;align-items:baseline;flex-wrap:wrap}
@media(max-width:520px){.dstep{grid-template-columns:1fr}}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:12px}
input[type=search]{font:16px Figtree,system-ui,sans-serif;padding:9px 12px;border:1px solid var(--edge);border-radius:10px;background:var(--bg);color:var(--ink)}
.keyc{border-left:8px solid var(--c);margin:20px 0}
.keyc h3{margin-bottom:4px}
.spot{position:fixed;inset:0;z-index:50;background:color-mix(in srgb,#000 55%,transparent);display:grid;place-items:center;padding:16px}
.spot[hidden]{display:none}
.spotbox{background:var(--bg);border-radius:20px;padding:22px;width:min(860px,100%);max-height:92vh;overflow:auto;animation:popin .45s cubic-bezier(.34,1.56,.64,1)}
.spotbox .qhead{font-size:clamp(22px,2.8vw,30px)}
.spotbox .opt{font-size:19px}
@keyframes popin{from{opacity:0;transform:scale(.9) translateY(20px)}to{opacity:1;transform:none}}
.count{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--amber);color:#111;font-weight:800;animation:tick 1s ease infinite}
@keyframes tick{0%{transform:scale(1.25)}100%{transform:scale(1)}}
.lib{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
@media(max-width:720px){.lib{grid-template-columns:1fr}}
.libc{display:flex;flex-direction:column;gap:8px}
.libc p.pr{background:var(--bg);border:1px solid var(--edge);border-radius:10px;padding:10px 12px;margin:0;font-size:16px;flex:1}
.libc .cat{font-size:14px;font-weight:700;color:var(--c)}
.sr{display:block;padding:12px 14px;border:1px solid var(--edge);border-radius:12px;margin:0 0 8px;text-decoration:none;color:var(--ink)}
.sr:hover{background:var(--panel)}
.sr small{display:block;color:var(--soft)}
.cert{position:relative;border:14px solid var(--ink);outline:3px solid var(--amber);outline-offset:-26px;padding:clamp(28px,5vw,60px);text-align:center;background:var(--bg);margin:20px 0}
.cert .ct{font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-.02em}
.cert .nm{font-size:clamp(30px,5vw,54px);font-weight:800;border-bottom:3px solid var(--amber);display:inline-block;padding:0 20px 6px;margin:14px 0;min-width:60%}
.cert .sig{display:flex;justify-content:space-around;gap:20px;flex-wrap:wrap;margin-top:34px}
.cert .sig div{border-top:2px solid var(--ink);padding-top:6px;min-width:180px;color:var(--soft)}
.cert .badge{width:70px;height:70px;margin:0 auto 10px}
@media print{body.printcert *{visibility:hidden}body.printcert #certbox,body.printcert #certbox *{visibility:visible}body.printcert #certbox{position:absolute;left:0;top:0;width:100%;margin:0}}
.tip{border-left:6px solid var(--blue);background:var(--panel);padding:12px 16px;border-radius:10px;margin:16px 0}
.tip ul{margin:.4em 0 0}
pre.p{min-height:0;margin:10px 0 16px}
ol{padding-left:1.4em;margin:.3em 0 .9em}
.lesson h2{font-size:clamp(22px,2.6vw,28px)}
</style>
</head>
<body>
