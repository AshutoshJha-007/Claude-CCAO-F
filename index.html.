const esc=t=>t.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
const demoCards=i=>DEMOS[i].map((d,j)=>`<div class="card demo"><h3>Demo ${j+1}: ${d.t}</h3>${d.s.map((x,k)=>`<div class="dstep">${d.s.length>1?`<span class="dl">Step ${k+1} of ${d.s.length}</span>`:""}<p class="pr">${esc(x)}</p><button class="btn" type="button" data-dcopy="${i}-${j}-${k}">Copy</button><span class="cmsg"></span></div>`).join("")}<p class="ex"><b>What to expect:</b> ${d.e}</p><p class="ex"><b>Point out to students:</b> ${d.p}</p></div>`).join("");
const demoBlock=i=>`<h3 style="font-size:26px;margin-top:28px">Live demos: run these in Claude</h3><p style="color:var(--soft)">Copy each prompt and paste it into Claude in front of your class or on video. Prompts with several steps go in the same chat, one after another. Change anything in [square brackets] first.</p>${demoCards(i)}`;
const testBody=()=>{setTimeout(score,0);return `<p>${TEST.length} workplace scenario questions, spread across the exam domains of both guides. Pick an answer, or click a question to see the answer right under it. Your score by domain appears below as you go.</p><p style="color:var(--soft)">These are our own practice questions, not real exam questions. The real exam has 60 scored questions (guide v1.1 adds 10 unscored ones, 70 in total), and some ask you to pick more than one answer.</p><div class="qtools"><b>Score by:</b><button class="btn" type="button" data-gv="1.1">Guide v1.1 (from 7 Dec 2026)</button><button class="btn" type="button" data-gv="1.0">Guide v1.0 (before 7 Dec 2026)</button></div><div class="qtools"><span class="score" id="score">Score: 0 / ${TEST.length}</span><button class="btn" type="button" id="treset">Start again</button></div><div id="dom" class="card" style="margin:0 0 16px"></div><div id="testq">${TEST.map((t,i)=>qaHTML({q:t[0],o:t[1],r:t[2],a:`<p>${t[3]}</p>`},"t"+i,i+1)).join("")}</div>`};
const lessonBlock=i=>{const l=LESSONS[i],v="lesson-"+(i+1);return `<section class="lesson" id="les-${i+1}"><div class="tag" style="--c:${C[l.m]}"><span class="dot"></span>Lesson ${i+1} of ${LESSONS.length} · ${l.d>=0?`Guide v1.0: Domain ${l.d+1} · ${DOMAINS[l.d]} (${DW[l.d]}%)`:(i===7?"New topics in exam guide v1.1":"Summary and exam prep")}<br><span style="font-weight:500">${VT[i]||""}</span></div><h2 class="lt">${l.t}</h2><p class="goal" style="--c:${C[l.m]}">${l.goal}</p>${l.body}<div class="say"><b>Say this to your students</b>"${l.say}"</div><div class="act"><b>Try this in Claude:</b> ${l.act}</div>${demoBlock(i)}<div class="card keyc" style="--c:${C[l.m]}"><h3>Remember: key points</h3><ul>${KEYS[i].map(k=>`<li>${k}</li>`).join("")}</ul></div><h3 style="font-size:26px;margin-top:28px">Check your understanding</h3><p style="color:var(--soft)">Think of your answer first. Then click the question to see the answer.</p><div class="qtools" data-scope="les-${i+1}"><button class="btn" type="button" data-all="show">Show answers for this lesson</button><button class="btn" type="button" data-all="hide">Hide them</button></div>${l.qs.map((q,k)=>qaHTML(q,"l"+i+"q"+k,k+1)).join("")}<label class="check"><input type="checkbox" id="done-${v}" data-done="${v}"${done[v]?" checked":""}> I finished lesson ${i+1}</label></section>`};
const weekView=k=>{const w=WEEKS[k];return `${hint}<div class="tag" style="--c:${w.c}"><span class="dot"></span>Week ${k+1} of ${WEEKS.length}</div><h1>Week ${k+1}: ${w.t}</h1><p class="goal" style="--c:${w.c}">${w.goal}</p>${weekHead(k)}${weekBody(k)}${navBtns("week-"+(k+1))}`};
let cur="home";
const setQA=(el,open,pick)=>{el.classList.toggle("open",open);el.querySelector(".qhead").setAttribute("aria-expanded",open);el.querySelector(".qtext small").textContent=open?"Click again to hide the answer":"Click to see the answer";
 const r=+el.dataset.r,you=el.querySelector(".you");el.querySelectorAll(".opt").forEach(b=>b.classList.remove("wrong"));
 if(open&&pick!==undefined&&r>=0){el.dataset.p=pick;if(pick!==r)el.querySelector(`.opt[data-j="${pick}"]`).classList.add("wrong");you.textContent=pick===r?"You got it right!":"Not quite. Your pick was "+L[pick]+"."}else{delete el.dataset.p;you.textContent=""}
 score()};
let gv=store.get("ca1-gv","1.1");
const score=()=>{const s=$("score");if(!s)return;const D=gv==="1.0"?DOMAINS:DOMAINS2,W=gv==="1.0"?DW:DW2,ix=gv==="1.0"?4:5;document.querySelectorAll("[data-gv]").forEach(b=>b.setAttribute("aria-pressed",b.dataset.gv===gv));let c=0,a=0;const by=D.map(()=>[0,0]);document.querySelectorAll("#testq .qa").forEach((q,i)=>{if(q.dataset.p===undefined)return;a++;const ok=+q.dataset.p===+q.dataset.r;if(ok)c++;const d=TEST[i][ix];by[d][1]++;if(ok)by[d][0]++});
 s.textContent=`Score: ${c} / ${TEST.length}`+(a===TEST.length?(c>=Math.ceil(TEST.length*0.72)?" · Above the 72% mark. Keep practising your weakest domain.":" · Below the 72% mark. Review your weakest domains and try again."):"");
 const dm=$("dom");if(dm)dm.innerHTML=`<b>Score by exam domain (guide v${gv})</b>`+D.map((n,d)=>{const t=TEST.filter(x=>x[ix]===d).length,[ok,dn]=by[d],w=dn?Math.round(ok/dn*100):0;return `<div style="display:grid;grid-template-columns:minmax(0,1fr) 7em;gap:10px;align-items:center;margin-top:8px"><div><div style="font-size:15px">${d+1}. ${n} <span style="color:var(--soft)">(${W[d]}% of exam)</span></div><div style="height:8px;background:var(--bg);border:1px solid var(--edge);border-radius:4px;overflow:hidden"><i style="display:block;height:100%;width:${w}%;background:${w>=72?"var(--ok)":"var(--amber)"}"></i></div></div><div style="text-align:right;font-weight:700;white-space:nowrap">${ok} / ${dn} of ${t}</div></div>`}).join("")};
const allQA=open=>document.querySelectorAll("#view .qa").forEach(q=>setQA(q,open));
const scrollTo2=id=>{const el=$(id);if(el)el.scrollIntoView({behavior:"smooth",block:"start"})};
const mark=()=>{document.querySelectorAll("#rail a[data-v],#tabs a").forEach(a=>a.classList.toggle("on",a.dataset.v===cur));const t=document.querySelector("#tabs a.on");if(t)t.scrollIntoView({block:"nearest",inline:"center"})};
const go=()=>{let v=(location.hash||"#home").slice(1);
 const m=v.match(/^lesson-(\d+)$/);if(m&&LESSONS[+m[1]-1]){pending=+m[1];v="week-"+(weekOf(+m[1]-1)+1)}
 if(!ORDER.includes(v))v="home";cur=v;
 $("view").innerHTML=v.startsWith("week-")?weekView(+v.slice(5)-1):views[v]();
 mark();$("b-all").textContent="Show all answers";pb();document.body.classList.toggle("printcert",v==="cert");
 if(pending){const p=pending;pending=null;setTimeout(()=>scrollTo2("les-"+p),30)}else window.scrollTo(0,0)};
const pb=()=>{const f=$("pb");if(!f)return;const v=id=>$(id).value.trim();const b=()=>{const L=["Task: "+v("pb-task")+"."];
 if(v("pb-ctx"))L.push("","Context: "+v("pb-ctx"));if(v("pb-ex"))L.push("","Example of the style I like: \""+v("pb-ex")+"\"");
 if(v("pb-con"))L.push("","Constraints: "+v("pb-con")+".");if(v("pb-role"))L.push("","Role and tone: "+v("pb-role")+".");
 if($("pb-steps").checked)L.push("","Let's do this in steps: first show me a short outline, and wait for my OK before writing the full version.");
 if($("pb-think").checked)L.push("","Before you answer, think step by step about what will work best.");
 L.push("","If anything is unclear, ask me up to 3 short questions first.");$("pb-out").textContent=L.join("\n")};
 f.addEventListener("input",b);f.addEventListener("change",b);f.addEventListener("submit",e=>e.preventDefault());b();
 $("pb-copy").addEventListener("click",async()=>{try{await navigator.clipboard.writeText($("pb-out").textContent);$("pb-msg").textContent="Copied. Paste it into Claude."}catch(e){$("pb-msg").textContent="Copy is blocked here. Select the text and copy it."}})};
let think=store.get("ca1-think",0);
const stopT=q=>{if(q._t){clearInterval(q._t);q._t=null}};
const openQ=q=>{if(q.classList.contains("open")||q._t)return;if(!think){setQA(q,true);return}
 let s=think;const sm=q.querySelector(".qtext small");const tick=()=>{sm.innerHTML=`<span class="count">${s}</span> Think about your answer…`};tick();
 q._t=setInterval(()=>{s--;if(s<=0){stopT(q);setQA(q,true)}else tick()},1000)};
const qaClick=e=>{const h=e.target.closest(".qhead");if(h){const q=h.closest(".qa");if(q.classList.contains("open"))setQA(q,false);else if(q._t){stopT(q);setQA(q,true)}else openQ(q);return true}
 const o=e.target.closest(".opt");if(o){const q=o.closest(".qa");if(q.classList.contains("open"))return true;stopT(q);setQA(q,true,+o.dataset.j);return true}return false};
const setThink=t=>{think=t;store.set("ca1-think",t);$("b-think").textContent="Think timer: "+(t?t+" sec":"off");$("b-think").setAttribute("aria-pressed",!!t)};
$("b-think").addEventListener("click",()=>setThink(think?0:5));setThink(think);
/* random question */
const POOL=[...LESSONS.flatMap((l,i)=>l.qs.map(q=>({q,src:"Lesson "+(i+1)+": "+l.t}))),...TEST.map(t=>({q:{q:t[0],o:t[1],r:t[2],a:`<p>${t[3]}</p>`},src:"Practice exam"}))];
let lastR=-1;
const showRand=()=>{let k;do{k=Math.floor(Math.random()*POOL.length)}while(k===lastR&&POOL.length>1);lastR=k;const p=POOL[k];
 $("spotsrc").textContent=p.src;$("spotq").innerHTML=qaHTML(p.q,"spotqa","?");$("spot").hidden=false;
 const box=document.querySelector(".spotbox");box.style.animation="none";void box.offsetWidth;box.style.animation="";$("spot-x").focus()};
const closeSpot=()=>{const q=$("spotqa");if(q)stopT(q);$("spot").hidden=true;$("b-rand").focus()};
$("b-rand").addEventListener("click",showRand);
$("spot").addEventListener("click",e=>{if(qaClick(e))return;if(e.target.id==="spot-x"||e.target.id==="spot")closeSpot();else if(e.target.id==="spot-next")showRand()});
/* search */
const strip=s=>s.replace(/<[^>]+>/g," ").replace(/\s+/g," ").toLowerCase();
const doSearch=()=>{const t=$("q").value.trim().toLowerCase();if(t.length<2){if(cur==="search")go();return}cur="search";mark();
 const hits=[];LESSONS.forEach((l,i)=>{if(strip(l.t+" "+l.s+" "+l.goal+" "+l.body+" "+KEYS[i].join(" ")+" "+DEMOS[i].map(d=>d.t+" "+d.s.join(" ")).join(" ")).includes(t))hits.push({i,txt:"Lesson "+(i+1)+": "+l.t,sub:"Week "+(weekOf(i)+1)+" · "+l.s});
  l.qs.forEach((q,k)=>{if(strip(q.q+" "+q.a).includes(t))hits.push({i,txt:"Q"+(k+1)+": "+q.q,sub:"Question in lesson "+(i+1)+": "+l.t})})});
 const g=GLOSS.filter(r=>strip(r.join(" ")).includes(t));
 $("view").innerHTML=`<h1>Search: “${t.replace(/</g,"&lt;")}”</h1><p style="color:var(--soft)">${hits.length+g.length} results</p>${hits.map(h=>`<a class="sr" href="#week-${weekOf(h.i)+1}" data-sr="${h.i+1}">${h.txt}<small>${h.sub}</small></a>`).join("")}${g.map(r=>`<a class="sr" href="#words">${r[0]}<small>Easy words · ${r[1]}</small></a>`).join("")}${hits.length+g.length?"":`<p>No results. Try a simpler word, like "prompt", "mask" or "safe".</p>`}`};
let sT;$("q").addEventListener("input",()=>{clearTimeout(sT);sT=setTimeout(doSearch,200)});
$("view").addEventListener("click",e=>{const a=e.target.closest("a[data-sr]");if(!a)return;e.preventDefault();$("q").value="";pending=+a.dataset.sr;const h=a.getAttribute("href");if(location.hash===h)go();else location.hash=h});
$("view").addEventListener("click",async e=>{const b=e.target.closest("[data-dcopy]");if(!b)return;const [a,c,k]=b.dataset.dcopy.split("-").map(Number);const m=b.parentNode.querySelector(".cmsg");try{await navigator.clipboard.writeText(DEMOS[a][c].s[k]);m.textContent="Copied! Paste it into Claude."}catch(x){m.textContent="Copy blocked here. Select the text and copy it."}});
$("view").addEventListener("click",async e=>{const b=e.target.closest("[data-copy]");if(!b)return;const m=b.parentNode.querySelector(".cmsg");try{await navigator.clipboard.writeText(LIB[+b.dataset.copy][2]);m.textContent="Copied! Paste it into Claude."}catch(x){m.textContent="Copy blocked here. Select the text and copy it."}});
$("view").addEventListener("input",e=>{if(e.target.id!=="cert-name")return;const v=e.target.value;$("cert-show").textContent=v||"Student Name";store.set("ca1-name",v)});
$("view").addEventListener("click",e=>{if(e.target.id!=="cert-print")return;$("cert-msg").textContent="If no print window opens, download the .html file, open it, and press Ctrl + P.";try{window.print()}catch(x){}});
$("view").addEventListener("click",e=>{if(qaClick(e))return;
 const a=e.target.closest("[data-all]");if(a){const sc=a.closest("[data-scope]");const box=sc?$(sc.dataset.scope):$("view");box.querySelectorAll(".qa").forEach(q=>setQA(q,a.dataset.all==="show"));return}
 if(e.target.id==="treset"){$("testq").querySelectorAll(".qa").forEach(q=>setQA(q,false));return}
 const j=e.target.closest("[data-jump]");if(j){e.preventDefault();scrollTo2(j.dataset.jump)}});
document.addEventListener("click",e=>{const a=e.target.closest("a[data-les]");if(!a)return;const href=a.getAttribute("href");if(location.hash===href||(!location.hash&&href==="#home")){e.preventDefault();scrollTo2("les-"+a.dataset.les)}else pending=+a.dataset.les});
$("view").addEventListener("change",e=>{const b=e.target.dataset.bp;if(!b)return;bpDone[b]=e.target.checked;store.set("ca1-bp",bpDone);const c=$("bpc");if(c)c.textContent=Object.values(bpDone).filter(Boolean).length});
$("view").addEventListener("click",e=>{const g=e.target.closest("[data-gv]");if(!g)return;gv=g.dataset.gv;store.set("ca1-gv",gv);score()});
$("view").addEventListener("change",e=>{const k=e.target.dataset.done;if(!k)return;done[k]=e.target.checked;store.set("ca1-done",done);rail();mark()});
$("b-all").addEventListener("click",()=>{const open=$("b-all").textContent.startsWith("Show");allQA(open);$("b-all").textContent=open?"Hide all answers":"Show all answers"});
const setPresent=p=>{document.body.classList.toggle("present",p);$("b-present").setAttribute("aria-pressed",p);store.set("ca1-present",p)};
$("b-present").addEventListener("click",()=>setPresent(!document.body.classList.contains("present")));
document.addEventListener("keydown",e=>{if(e.target.closest("input,textarea,select")||e.ctrlKey||e.metaKey||e.altKey)return;const k=e.key.toLowerCase();
 if(k==="f"){const d=document;try{const p=d.fullscreenElement?d.exitFullscreen():d.documentElement.requestFullscreen();if(p&&p.catch)p.catch(()=>{})}catch(x){}return}
 if(!$("spot").hidden){if(k==="escape")closeSpot();else if(k==="r")showRand();else if(k==="n"){const q=$("spotqa");if(q)openQ(q)}return}
 if(k==="r"){showRand();return}
 const i=ORDER.indexOf(cur);
 if(e.key==="ArrowRight"&&ORDER[i+1])location.hash=ORDER[i+1];
 else if(e.key==="ArrowLeft"&&ORDER[i-1])location.hash=ORDER[i-1];
 else if(k==="n"){const q=document.querySelector("#view .qa:not(.open)");if(q){openQ(q);q.scrollIntoView({behavior:"smooth",block:"center"})}}
 else if(k==="h"){document.querySelectorAll("#view .qa").forEach(stopT);allQA(false)}});
window.addEventListener("hashchange",go);
/* MOBILE: drawer, tools, bottom nav, text size, swipe, back to top */
const drawer=o=>{document.body.classList.toggle("drawer",o);$("b-menu").setAttribute("aria-expanded",o);if(o){const a=document.querySelector("#rail a.on");if(a)a.scrollIntoView({block:"center"})}};
$("b-menu").addEventListener("click",()=>drawer(true));$("bn-menu").addEventListener("click",()=>drawer(true));
$("scrim").addEventListener("click",()=>drawer(false));
$("rail").addEventListener("click",e=>{if(e.target.closest("#drawx")||e.target.closest("a"))drawer(false)});
$("b-tools").addEventListener("click",()=>{const t=document.querySelector(".top"),o=!t.classList.contains("toolsopen");t.classList.toggle("toolsopen",o);$("b-tools").setAttribute("aria-expanded",o);if(o)$("q").focus()});
$("bn-rand").addEventListener("click",()=>showRand());
const FS=[1,1.12,1.25,0.92];let fsi=store.get("ca1-fs",0);
const setFS=i=>{fsi=i%FS.length;document.documentElement.style.setProperty("--fs",FS[fsi]);$("fslbl").textContent="Text "+Math.round(FS[fsi]*100)+"%";store.set("ca1-fs",fsi)};
$("bn-fs").addEventListener("click",()=>setFS(fsi+1));setFS(fsi);
const bnav=()=>{const i=ORDER.indexOf(cur),p=ORDER[i-1],n=ORDER[i+1];const P=$("bn-prev"),N=$("bn-next");P.href="#"+(p||cur);N.href="#"+(n||cur);P.setAttribute("aria-disabled",!p);N.setAttribute("aria-disabled",!n);P.title=p?NAMES[p]:"";N.title=n?NAMES[n]:""};
window.addEventListener("hashchange",()=>{drawer(false);setTimeout(bnav,0)});
window.addEventListener("scroll",()=>$("totop").classList.toggle("show",window.scrollY>700),{passive:true});
$("totop").addEventListener("click",()=>window.scrollTo({top:0,behavior:"smooth"}));
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&document.body.classList.contains("drawer"))drawer(false)});
let tx=0,ty=0,tt=0,tok=false;
document.querySelector("main").addEventListener("touchstart",e=>{const t=e.touches[0];tx=t.clientX;ty=t.clientY;tt=Date.now();tok=e.touches.length===1&&!e.target.closest(".scroll,pre,input,textarea,select,.tabs,table,.cert")},{passive:true});
document.querySelector("main").addEventListener("touchend",e=>{if(!tok||document.body.classList.contains("drawer"))return;const t=e.changedTouches[0],dx=t.clientX-tx,dy=t.clientY-ty;if(Math.abs(dx)>90&&Math.abs(dy)<45&&Date.now()-tt<600){const i=ORDER.indexOf(cur),to=dx<0?ORDER[i+1]:ORDER[i-1];if(to)location.hash=to}},{passive:true});

const hh=()=>{const h=document.querySelector('.top').offsetHeight;document.documentElement.style.setProperty('--hh',h+'px');document.documentElement.style.scrollPaddingTop=(h+12)+'px'};const hro=new ResizeObserver(hh);hro.observe(document.querySelector('.top'));
setPresent(store.get("ca1-present",false)&&innerWidth>900);rail();go();bnav();
}
</script>
</body>
</html>
